SELECT
    emp_id,
    name,
    department,
    salary,
    SUM(salary) OVER () AS total_company_payroll
FROM employees_messy;

SELECT
    emp_id,
    name,
    department,
    salary,
    COUNT(*) OVER (
        PARTITION BY department
    ) AS department_employee_count
FROM employees_messy;

SELECT
    emp_id,
    name,
    department,
    salary,
    AVG(salary) OVER (
        PARTITION BY department
    ) AS department_avg_salary
FROM employees_messy;

SELECT
    emp_id,
    name,
    department,
    salary,
    MAX(salary) OVER (
        PARTITION BY department
    ) AS department_max_salary
FROM employees_messy;

SELECT
    emp_id,
    name,
    department,
    salary,
    ROW_NUMBER() OVER (
        PARTITION BY department
        ORDER BY salary DESC
    ) AS salary_position
FROM employees_messy;


SELECT
    emp_id,
    name,
    department,
    salary,
    RANK() OVER (
        PARTITION BY department
        ORDER BY salary DESC
    ) AS salary_rank
FROM employees_messy;

SELECT
    emp_id,
    name,
    department,
    salary,
    DENSE_RANK() OVER (
        PARTITION BY department
        ORDER BY salary DESC
    ) AS dense_salary_rank
FROM employees_messy;

WITH ranked_employees AS (
    SELECT
        emp_id,
        name,
        department,
        salary,
        ROW_NUMBER() OVER (
            PARTITION BY department
            ORDER BY salary DESC
        ) AS rn
    FROM employees_messy
)
SELECT
    emp_id,
    name,
    department,
    salary,
    rn AS salary_position
FROM ranked_employees
WHERE rn <= 3
ORDER BY department, salary DESC;

WITH ranked_employees AS (
    SELECT
        emp_id,
        name,
        department,
        salary,
        RANK() OVER (
            PARTITION BY department
            ORDER BY salary DESC
        ) AS rnk
    FROM employees_messy
)
SELECT
    emp_id,
    name,
    department,
    salary,
    rnk
FROM ranked_employees
WHERE rnk <= 3
ORDER BY department, salary DESC;


SELECT
    emp_id,
    name,
    department,
    salary,
    SUM(salary) OVER (
        ORDER BY salary DESC
        ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
    ) AS running_salary_total
FROM employees_messy
ORDER BY salary DESC;

SELECT
    emp_id,
    name,
    department,
    salary,
    NTILE(4) OVER (
        ORDER BY salary DESC
    ) AS salary_quartile
FROM employees_messy;
